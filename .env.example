# Copia este archivo como .env y ajusta los valores. Nunca subas el .env a git.
# Lista completa y explicación: docs/TECH_SPEC.md §14.2.

NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Base de datos (npm run db:reset y npm run db:reset:test)
DATABASE_URL=postgres://sanctuary:sanctuary@localhost:5432/sanctuary
TEST_DATABASE_URL=postgres://sanctuary:sanctuary@localhost:5432/sanctuary_test

# Carpeta de archivos subidos (relativa a server/)
UPLOADS_DIR=./uploads

# Firma de la cookie de sesión: 32 caracteres aleatorios o más.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Correo: Mailpit en local (interfaz en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Santuario <no-reply@santuario.test>"
