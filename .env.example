# Copia este archivo como .env y ajusta los valores. Nunca subas el .env a git.
# Lista completa y explicación: docs/TECH_SPEC.md §14.2.

NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Base de datos (aún no se usan; se activarán con npm run db:reset)
DATABASE_URL=postgres://sanctuary:sanctuary@localhost:5432/sanctuary
TEST_DATABASE_URL=postgres://sanctuary:sanctuary@localhost:5432/sanctuary_test

# Carpeta de archivos subidos (relativa a server/)
UPLOADS_DIR=./uploads
